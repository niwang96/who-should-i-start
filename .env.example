# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
# Free tier: gemini-3.5-flash-lite allows 500 requests/day (gemini-3.5-flash only 20).
GEMINI_MODEL=gemini-3.5-flash-lite
FANTASYPROS_API_KEY=
# Supabase Postgres. Ingest/GitHub Actions: Connect > Session pooler URI. Web app/Vercel: Connect >
# Transaction pooler URI (port 6543). When unset, the local SQLite file is used.
DATABASE_URL=
STARTSIT_DB_PATH=data/startsit.db
# Web app only: secret salt for hashing visitor IPs (per-visitor AI limits). Any long random string.
VISITOR_SALT=
